# Database configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:YourNewPassword@localhost:5432/rejectioniq

# JWT Auth Security Key
SECRET_KEY=super_secret_key_change_in_production

# Option 1: Free Resend Email API Key (3,000 free emails/month - https://resend.com)
RESEND_API_KEY=re_123456789...

# Option 2: Free Brevo Email API Key (300 free emails/day - https://brevo.com)
BREVO_API_KEY=xkeysib-...

# Option 3: Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-email@gmail.com
